extends base
block content
  section.page-hero
    .page-hero__inner
      .page-hero__breadcrumb
        a.page-hero__breadcrumb-link(href='/dashboard') Dashboard
        span.page-hero__breadcrumb-sep /
        span My Listings
      h1.page-hero__title My Listings
      p.page-hero__subtitle Manage, edit, and track all your property listings.
  main.page-main
    .my-listings-page
      .my-listings-header
        a.btn.btn--outline.btn--small(href='/dashboard')
          svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
            line(x1='19' y1='12' x2='5' y2='12')
            polyline(points='12 19 5 12 12 5')
          |  Back to Dashboard

      if properties && properties.length
        .listings-grid
          each prop in properties
            div.listing-card(style='position: relative;')
              a.listing-card__link(href=`/${prop.slug}`)
              .listing-card__img-wrap
                if prop.photos && prop.photos.length
                  img.listing-card__img(src=`/img/properties/${prop.photos[0]}` alt=prop.title loading='lazy' onerror="this.src='/img/properties/property-1-main.jpg'")
                else
                  img.listing-card__img(src='/img/properties/property-1-main.jpg' alt='No image available' loading='lazy')
                span.listing-card__tag=prop.type
                .listing-card__status-badge
                  - const sc = prop.status === 'approved' ? 'badge--active' : prop.status === 'pending' ? 'badge--pending' : prop.status === 'rejected' ? 'badge--inactive' : 'badge--draft'
                  span.badge(class=sc)= prop.status.charAt(0).toUpperCase() + prop.status.slice(1)
              .listing-card__body
                p.listing-card__price
                  | ETB #{prop.rent.toLocaleString()} 
                  span / month
                p.listing-card__type=prop.type
                p.listing-card__location=`${prop.location.subcity}, ${prop.location.city}`
                .listing-card__meta
                  span.listing-card__meta-item
                    | #{prop.bedroom}
                    svg.listing-card__icon
                      use(xlink:href='/css/icons-sprite.svg#icon-bed')
                  span.listing-card__meta-item
                    | #{prop.bathroom || '—'}
                    svg.listing-card__icon
                      use(xlink:href='/css/icons-sprite.svg#icon-bath')
                .listing-card__actions
                  a.btn.btn--secondary.btn--small(href=`/post-listing?edit=${prop._id}`)
                    svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                      path(d='M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7')
                      path(d='M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z')
                    |  Edit
      else
        .empty-state
          .empty-state__icon
            svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round')
              path(d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z')
              polyline(points='9 22 9 12 15 12 15 22')
          h2.empty-state__title No listings yet
          p.empty-state__text You haven't created any property listings. Start by adding your first property to reach potential tenants.
          a.btn.btn--primary(href='/dashboard') ← Back to Dashboard

