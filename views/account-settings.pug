extends base
block content 
  section.page-hero
    .page-hero__inner
      h1.page-hero__title Account Settings
      p.page-hero__subtitle Manage your profile, security and notification preferences.
  main.page-main
    .dashboard
      aside.dashboard__sidebar
        ul.dashboard__nav
          li.dashboard__nav-item
            a(href='/dashboard') Overview
          if user.role === 'landlord'
            li.dashboard__nav-item
              a(href='/post-listing') Post new listing
            li.dashboard__nav-item
              a(href='/my-listings') My listings
            li.dashboard__nav-item
              a(href='/enquiries') Enquiries
          li.dashboard__nav-item
            a.dashboard__nav-link--active(href='/account-settings') Account settings
      div
        .dashboard__panel
          .dashboard__panel-header
            h3.dashboard__panel-title Profile Information
          form#userDataForm(method='post' action='#' enctype='multipart/form-data')
            .form__group
              label.form__label Profile Photo
              .form__profile-photo
                .form__profile-photo-wrapper
                  if user.photo
                    img.form__profile-photo-image(src=`/img/users/${user.photo}` alt='Profile photo')
                  else
                     img.form__profile-photo-image(src='/img/users/default.jpg' alt='Default avatar')
                  .form__profile-photo-overlay
                    span.form__profile-photo-icon
                      svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' width='20' height='20')
                        path(d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4')
                        polyline(points='17 8 12 3 7 8')
                        line(x1='12' y1='3' x2='12' y2='15')
                    span.form__profile-photo-text Change
                input#photo.form__file-input(type='file' name='photo' accept='image/*' style='display: none;')
            .form__group
              label.form__label Full Name
              input#userName.form__input(type='text' name='name' value=user.name placeholder='Your full name' autocomplete='name' required)
            .form__group
              label.form__label Email Address
              input#userEmail.form__input(type='email' name='email' value=user.email placeholder='your@email.com' autocomplete='email' required)
            .form__group
              label.form__label Phone Number
              input#userPhone.form__input(type='tel' name='phoneNumber' value=user.phoneNumber placeholder='+251 9X XXX XXXX' autocomplete='tel')
            .form__group
              label.form__label Bio
              textarea#userBio.form__textarea(name='bio' placeholder='Tell us about yourself...' rows='3')= user.bio || ''
            .form__group
              button.btn.btn--primary(type='submit') Save Changes

        .dashboard__panel
          .dashboard__panel-header
            h3.dashboard__panel-title Security
          form#updatePasswordForm(method='post' action='#')
            .form__group
              label.form__label Current Password
              input#passwordCurrent.form__input(type='password' name='passwordCurrent' placeholder='Enter current password' autocomplete='current-password' required)
            .form__group
              label.form__label New Password
              input#password.form__input(type='password' name='password' placeholder='Enter new password' autocomplete='new-password' required)
            .form__group
              label.form__label Confirm Password
              input#passwordConfirm.form__input(type='password' name='passwordConfirm' placeholder='Confirm new password' autocomplete='new-password' required)
            .form__group
              button.btn.btn--primary(type='submit') Update Password

        .dashboard__panel
          .dashboard__panel-header
            h3.dashboard__panel-title Notifications
          form#notificationsForm(method='post' action='#')
            .form__checkbox
              input(type='checkbox' name='notifEnquiries' id='notifEnquiries' checked)
              label(for='notifEnquiries') Email me when I receive new property enquiries
            .form__checkbox
              input(type='checkbox' name='notifAccount' id='notifAccount' checked)
              label(for='notifAccount') Email me when my profile or password is updated
            .form__group
              button.btn.btn--primary(type='submit') Save Preferences

        .dashboard__panel(style='background: #fef2f2; border: 1px solid rgba(239, 68, 68, 0.2);')
          .dashboard__panel-header
            h3.dashboard__panel-title(style='color: #dc2626;') Danger Zone
          p(style='margin-bottom: 2rem; color: $color-muted;') Deleting your account will remove all your listings, enquiries, and personal data. This action cannot be undone.
          button.btn.btn--danger(type='button' id='delete-account-btn') Delete Account
