extends base
block content 
  section.page-hero
    .page-hero__inner
      h1.page-hero__title= property ? 'Edit your rental property' : 'Post your rental property'
      p.page-hero__subtitle
        | 100% free advertising. No hidden fees. Reach thousands of verified
        | tenants across Addis Ababa.
  main.page-main
    nav.breadcrumb(aria-label='Breadcrumb')
      a.breadcrumb__link(href='/homepage') Home
      span.breadcrumb__sep /
      a.breadcrumb__link(href='/dashboard') Dashboard
      span.breadcrumb__sep /
      span.breadcrumb__current= property ? 'Edit listing' : 'Post listing'
    .post-listing
      .post-listing__intro
        h2= property ? 'Edit your property details' : 'Tell us about your property'
        p
          | Fill in the details below. You can save as a draft and publish when
          | you&apos;re ready.
      form#post.post-listing__form(data-is-edit=isEdit data-property-id=property ? property._id : '' type='submit')
        section.post-listing__section
          h3.post-listing__section-title Basic details
          p.post-listing__section-desc
            | Start with the property type, location, and monthly rent.
          .form__group
            label.form__label(for='title') Listing title
            input#title.form__input(type='text', name='title' placeholder='e.g. 3 Bed Condominium in Kasanchis' required='' value=property ? property.title : '')
          .form__row
            .form__group
              label.form__label(for='property-type') Property type
              select#property-type.form__select(required='',name='type')
                option(value='') Select type
                option(value='Apartment' selected=property && property.type === 'Apartment') Apartment
                option(value='Condominium' selected=property && property.type === 'Condominium') Condominium
                option(value='Studio' selected=property && property.type === 'Studio') Studio
                option(value='Room shared' selected=property && property.type === 'Room shared') Room shared
                option(value='House' selected=property && property.type === 'House') House
            .form__group
              label.form__label(for='rent') Monthly rent (ETB)
              input#rent.form__input(type='number' placeholder='15000' required='', name='rent' value=property ? property.rent : '')
          .form__row
            .form__group
              label.form__label(for='city') City
              input#city.form__input(type='text' value=property && property.location ? property.location.city : 'Addis Ababa' required='',name='city')
            .form__group
              label.form__label(for='subcity') Subcity
              select#subcity.form__select(required='' name='subcity')
                option(value='') Select subcity
                option(value='Arada' selected=property && property.location && property.location.subcity === 'Arada') Arada
                option(value='Akaki Kality' selected=property && property.location && property.location.subcity === 'Akaki Kality') Akaki Kality
                option(value='Bole' selected=property && property.location && property.location.subcity === 'Bole') Bole
                option(value='Gulele' selected=property && property.location && property.location.subcity === 'Gulele') Gulele
                option(value='Kirkos' selected=property && property.location && property.location.subcity === 'Kirkos') Kirkos
                option(value='Kolfe Keranio' selected=property && property.location && property.location.subcity === 'Kolfe Keranio') Kolfe Keranio
                option(value='Lideta' selected=property && property.location && property.location.subcity === 'Lideta') Lideta
                option(value='Nifas Silk' selected=property && property.location && property.location.subcity === 'Nifas Silk') Nifas Silk
                option(value='Yeka' selected=property && property.location && property.location.subcity === 'Yeka') Yeka
          .form__row
            .form__group
              label.form__label(for='woreda') Woreda
              input#woreda.form__input(type='text' placeholder='e.g. Woreda 01' required='' value=property && property.location ? property.location.woreda : '')
            .form__group
              label.form__label(for='kebele') Kebele
              input#kebele.form__input(type='text' placeholder='e.g. Kebele 01' required='' value=property && property.location ? property.location.kebele : '')
        section.post-listing__section
          h3.post-listing__section-title Property specs
          p.post-listing__section-desc
            | Help tenants understand the size and layout.
          .form__row
            .form__group
              label.form__label(for='bedrooms') Bedrooms
              select#bedrooms.form__select(required='' name='bedroom')
                option(value='') Select
                option(value='1' selected=property && property.bedroom === 1) 1
                option(value='2' selected=property && property.bedroom === 2) 2
                option(value='3' selected=property && property.bedroom === 3) 3
                option(value='4' selected=property && property.bedroom === 4) 4
                option(value='5' selected=property && property.bedroom === 5) 5+
            .form__group
              label.form__label(for='bathrooms') Bathrooms
              select#bathrooms.form__select(required='' name='bathroom')
                option(value='') Select
                option(value='1' selected=property && property.bathroom === 1) 1
                option(value='2' selected=property && property.bathroom === 2) 2
                option(value='3' selected=property && property.bathroom === 3) 3
                option(value='4' selected=property && property.bathroom === 4) 4+
          .form__group
            label.form__label(for='description') Description
            textarea#description.form__textarea(placeholder='Describe the property, neighbourhood, and what makes it special...' required='')=property ? property.description : ''
            p.form__hint Minimum 50 characters recommended.
        section.post-listing__section
          h3.post-listing__section-title Photos
          p.post-listing__section-desc
            | Upload clear photos of each room. Listings with 5+ photos get 3&times;
            | more views.
          .post-listing__upload
            input#photos.post-listing__file-input(type='file' name='photos' accept='image/*' multiple style='display: none;')
            .post-listing__upload-content
              svg.post-listing__upload-icon
                use(xlink:href='./css/icons-sprite.svg#icon-search')
              p.post-listing__upload-text
                | Drag &amp; drop photos here, or click to browse
              p.post-listing__upload-hint
                | JPG or PNG, up to 10 MB each. Max 12 photos.
          .post-listing__preview#photo-preview
        section.post-listing__section
          h3.post-listing__section-title Video (Optional)
          p.post-listing__section-desc
            | Add a video tour to showcase your property. Maximum 30 seconds.
          .post-listing__upload
            input#video.post-listing__file-input(type='file' name='video' accept='video/mp4,video/webm,video/quicktime' style='display: none;')
            .post-listing__upload-content
              svg.post-listing__upload-icon
                use(xlink:href='./css/icons-sprite.svg#icon-search')
              p.post-listing__upload-text
                | Drag &amp; drop video here, or click to browse
              p.post-listing__upload-hint
                | MP4, WebM, or MOV. Max 30 seconds, up to 50 MB.
          .post-listing__preview#video-preview
        section.post-listing__section
          h3.post-listing__section-title Amenities
          p.post-listing__section-desc
            | Select everything that&apos;s included with the rental.
          .post-listing__amenities-grid
            label.form__checkbox
              input(type='checkbox' name='amenity' value='parking' checked=property && property.amenities && property.amenities.includes('parking'))
              |                 Secure parking
            label.form__checkbox
              input(type='checkbox' name='amenity' value='security' checked=property && property.amenities && property.amenities.includes('security'))
              |                 24-hour security
            label.form__checkbox
              input(type='checkbox' name='amenity' value='balcony' checked=property && property.amenities && property.amenities.includes('balcony'))
              |                 Balcony
            label.form__checkbox
              input(type='checkbox' name='amenity' value='water' checked=property && property.amenities && property.amenities.includes('water'))
              |                 Water included
            label.form__checkbox
              input(type='checkbox' name='amenity' value='elevator' checked=property && property.amenities && property.amenities.includes('elevator'))
              |                 Elevator
            label.form__checkbox
              input(type='checkbox' name='amenity' value='generator' checked=property && property.amenities && property.amenities.includes('generator'))
              |                 Backup generator
            label.form__checkbox
              input(type='checkbox' name='amenity' value='furnished' checked=property && property.amenities && property.amenities.includes('furnished'))
              |                 Furnished
            label.form__checkbox
              input(type='checkbox' name='amenity' value='wifi' checked=property && property.amenities && property.amenities.includes('wifi'))
              |                 Wi-Fi included
            label.form__checkbox
              input(type='checkbox' name='amenity' value='pets' checked=property && property.amenities && property.amenities.includes('pets'))
              |                 Pets allowed
        section.post-listing__section
          h3.post-listing__section-title Contact details
          p.post-listing__section-desc
            | Tenants will use this to reach you about viewings.
          .form__row
            .form__group
              label.form__label(for='contact-name') Contact name
              input#contact-name.form__input(type='text' placeholder='Your full name' required='' value=`${user.name}`)
            .form__group
              label.form__label(for='contact-phone') Phone number
              .form__input-group
                // <span class="form__input-prefix">+251</span>
                input#contact-phone.form__input(type='tel' placeholder='911234567' pattern='[0-9]{9}' maxlength='9' required='' value=`${user.phoneNumber? user.phoneNumber: ''}`)
        .post-listing__actions
          button.btn.btn--outline(type='button')
            | Save as draft
          button.btn.btn--primary(type='submit')
            | #{property ? 'Update listing' : 'Publish listing'}
