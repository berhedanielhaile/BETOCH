extends base
block content 
  section.page-hero
    .page-hero__inner
      h1.page-hero__title Your dashboard
      p.page-hero__subtitle
        | Manage your properties, track enquiries, and keep listings up to date.
  main.page-main
    .dashboard
      aside.dashboard__sidebar
        ul.dashboard__nav
          li.dashboard__nav-item
            a.dashboard__nav-link--active(href='/dashboard') Overview
          if role === 'landlord'
            li.dashboard__nav-item
              a(href='/post-listing') Post new listing
            li.dashboard__nav-item
              a(href='/my-listings') My listings
            li.dashboard__nav-item
              a(href='/enquiries') Enquiries
          li.dashboard__nav-item
            a(href='/account-settings') Account settings
      div
        .dashboard__welcome
          .dashboard__user-details
            h2 hey, #{user.name.split(' ')[0]}
              if role === 'landlord'
                p Manage your properties and enquiries from interested tenants.
              else
                p Track your sent enquiries and follow up on viewing requests.

        if role === 'landlord'
          .dashboard__stats
            .dashboard__stat-card
              p.dashboard__stat-value #{activeListings}
              p.dashboard__stat-label Active listings
            .dashboard__stat-card
              p.dashboard__stat-value #{totalViews}
              p.dashboard__stat-label Total views
            .dashboard__stat-card
              p.dashboard__stat-value #{newEnquiries}
              p.dashboard__stat-label New enquiries
          .dashboard__panel
            .dashboard__panel-header
              h3.dashboard__panel-title Your listings
              a.btn.btn--primary.btn--small(href='/post-listing') + New listing
            .dashboard__table-wrap
              table.dashboard__table
                thead
                  tr
                    th Property
                    th Location
                    th Price
                    th Status
                    th Views
                    th Actions
                if properties && properties.length
                  each prop in properties
                    tbody
                      tr
                        td
                          a(href=`/${prop.slug}`)= prop.title
                        td #{prop.location.subcity || 'Unknown'}
                        td &pound;#{prop.rent}/mo
                        td
                          - const statusClass = prop.status === 'approved' ? 'badge--active' : prop.status === 'pending' ? 'badge--pending' : prop.status === 'rejected' ? 'badge--inactive' : prop.status === 'rented' ? 'badge--active' : 'badge'
                          span.badge(class=statusClass)= prop.status.charAt(0).toUpperCase() + prop.status.slice(1)
                        td #{prop.views || 0}
                        td.dashboard__actions
                          a.btn.btn--outline.btn--small(href=`/${prop.slug}`) View
                          a.btn.btn--secondary.btn--small(href=`/post-listing?edit=${prop._id}`) Edit
                else
                  tbody
                    tr
                      td(colspan='6') No listings found.
          .dashboard__panel
            .dashboard__panel-header
              h3.dashboard__panel-title Recent enquiries
            .dashboard__table-wrap
              table.dashboard__table
                thead
                  tr
                    th Tenant
                    th Property
                    th Date
                    th Message
                if enquiries && enquiries.length
                  each enq in enquiries
                    tbody
                      tr
                        td
                          if enq.user
                            | #{enq.user.name}
                            br
                            small #{enq.user.email}
                          else
                            | #{enq.name}
                            br
                            small #{enq.email}
                        td
                          if enq.property
                            a(href=`/${enq.property.slug}`)= enq.property.title
                          else
                            | Unknown
                        td #{enq.createdAt ? enq.createdAt.toDateString() : 'Unknown'}
                        td= enq.message
                else
                  tbody
                    tr
                      td(colspan='4') No enquiries yet.
        else
          .dashboard__panel
            .dashboard__panel-header
              h3.dashboard__panel-title Sent enquiries
            .dashboard__panel-body
              p.dashboard__panel-text
                | These are the enquiries you have sent to landlords. You can follow up from the property page once a landlord responds.
            .dashboard__panel
              .dashboard__table-wrap
                table.dashboard__table
                  thead
                    tr
                      th Property
                      th Date
                      th Message
                      th Status
                  if enquiries && enquiries.length
                    each enq in enquiries
                      tbody
                        tr
                          td
                            if enq.property
                              a(href=`/${enq.property.slug}`)= enq.property.title
                            else
                              | Unknown
                          td #{enq.createdAt ? enq.createdAt.toDateString() : 'Unknown'}
                          td= enq.message
                          td
                            - const statusClass = enq.status === 'accepted' ? 'badge--active' : enq.status === 'pending' ? 'badge--pending' : enq.status === 'declined' ? 'badge--inactive' : 'badge'
                            span.badge(class=statusClass)= enq.status.charAt(0).toUpperCase() + enq.status.slice(1)
                            if enq.status === 'accepted' && enq.contactValue
                              br
                              .dashboard__contact-info
                                small.dashboard__contact-method
                                  if enq.contactPreference === 'telegram'
                                    a.dashboard__contact-link(href=`https://t.me/${enq.contactValue}` target='_blank' rel='noopener noreferrer')
                                      svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' width='14' height='14')
                                        path(d='M22 2L11 13')
                                        path(d='M22 2l-7 20-4-9-9-4 20-7z')
                                      | Telegram: #{enq.contactValue}
                                  else if enq.contactPreference === 'whatsapp'
                                    a.dashboard__contact-link(href=`https://wa.me/${enq.contactValue}` target='_blank' rel='noopener noreferrer')
                                      svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' width='14' height='14')
                                        path(d='M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z')
                                      | WhatsApp: #{enq.contactValue}
                                  else
                                    a.dashboard__contact-link(href=`tel:${enq.contactValue}`)
                                      svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' width='14' height='14')
                                        path(d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z')
                                      | Phone: #{enq.contactValue}
                  else
                    tbody
                      tr
                        td(colspan='4') No sent enquiries yet.
