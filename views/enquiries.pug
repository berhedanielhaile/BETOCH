extends base
block content
  section.page-hero
    .page-hero__inner
      .page-hero__breadcrumb
        a.page-hero__breadcrumb-link(href='/dashboard') Dashboard
        span.page-hero__breadcrumb-sep /
        span Enquiries
      h1.page-hero__title Enquiries
      p.page-hero__subtitle Track and manage messages from tenants and visitors.
  main.page-main
    .enquiries-page
      .enquiries-toolbar
        .enquiries-toolbar__info
          if enquiries && enquiries.length
            p.enquiries-toolbar__count
              strong #{enquiries.length}
              |  enquir#{enquiries.length !== 1 ? 'ies' : 'y'} received
          //- else
          //-   p.enquiries-toolbar__count No enquiries yet
        a.btn.btn--outline.btn--small(href='/dashboard') ← Back to Dashboard

      if enquiries && enquiries.length
        .enquiries-list
          each enq in enquiries
            article.enquiry-card
              .enquiry-card__avatar
                if role === 'landlord'
                  if enq.user
                    span= enq.user.name.charAt(0).toUpperCase()
                  else
                    span= enq.name ? enq.name.charAt(0).toUpperCase() : '?'
                else
                  if enq.property
                    span= enq.property.title.charAt(0).toUpperCase()
                  else
                    span= enq.message ? enq.message.charAt(0).toUpperCase() : '?' 
              .enquiry-card__body
                .enquiry-card__header
                  if role === 'landlord'
                    .enquiry-card__from
                      strong.enquiry-card__name
                        if enq.user
                          = enq.user.name
                        else
                          = enq.name || 'Anonymous'
                      span.enquiry-card__email
                        if enq.user
                          = enq.user.email
                        else
                          = enq.email || ''
                  .enquiry-card__meta
                    if enq.property
                      a.enquiry-card__property(href=`/property/${enq.property.slug}`)
                        svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                          path(d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z')
                          polyline(points='9 22 9 12 15 12 15 22')
                        = enq.property.title
                    span.enquiry-card__date
                      svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                        rect(x='3' y='4' width='18' height='18' rx='2' ry='2')
                        line(x1='16' y1='2' x2='16' y2='6')
                        line(x1='8' y1='2' x2='8' y2='6')
                        line(x1='3' y1='10' x2='21' y2='10')
                      = enq.createdAt.toDateString()
                p.enquiry-card__message= enq.message
                if role === 'landlord'
                  if enq.status === 'pending'
                    form.enquiry-card__response-form
                      .enquiry-card__response-fields
                        label.enquiry-card__response-label
                          span Contact method
                          select.form__select(name='contactPreference')
                            option(value='phone' selected) Phone
                            option(value='telegram') Telegram
                            option(value='whatsapp') WhatsApp
                        label.enquiry-card__response-label
                          span Contact detail
                          input.form__input(type='text' name='contactValue' value=(enq.phone || '') placeholder='Phone number or Telegram/WhatsApp handle')
                      .enquiry-card__actions
                        button.btn.btn--primary.btn--small(type='button' data-enquiry-action='accept' data-enquiry-id=enq._id) Accept
                        button.btn.btn--outline.btn--small(type='button' data-enquiry-action='decline' data-enquiry-id=enq._id) Decline
                  else if enq.status === 'accepted'
                    .enquiry-card__note
                      p You accepted this request • Contact method shared with tenant
                  else
                    .enquiry-card__note
                      p Request declined
                else
                  .enquiry-card__note
                    if enq.status === 'accepted'
                      .enquiry-card__accepted-message
                        .enquiry-card__accepted-header
                          svg.enquiry-card__accepted-icon(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                            path(d='M22 11.08V12a10 10 0 1 1-5.93-9.14')
                            polyline(points='22 4 12 14.01 9 11.01')
                          span Request accepted
                        .enquiry-card__contact-info
                          span.enquiry-card__contact-label Preferred contact:
                          span.enquiry-card__contact-method #{enq.contactPreference ? enq.contactPreference.charAt(0).toUpperCase() + enq.contactPreference.slice(1) : 'Phone'}
                        .enquiry-card__contact-actions
                          if enq.contactPreference === 'telegram'
                            a.enquiry-card__contact-btn(href=`https://t.me/${enq.contactValue}` target='_blank' rel='noopener noreferrer')
                              svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                                path(d='M22 2L11 13')
                                path(d='M22 2l-7 20-4-9-9-4 20-7z')
                              span Open Telegram
                          else if enq.contactPreference === 'whatsapp'
                            a.enquiry-card__contact-btn(href=`https://wa.me/${enq.contactValue}` target='_blank' rel='noopener noreferrer')
                              svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                                path(d='M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z')
                              span Open WhatsApp
                          else if enq.contactValue
                            a.enquiry-card__contact-btn(href=`tel:${enq.contactValue}`)
                              svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                                path(d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z')
                              span Call landlord
                    else if enq.status === 'declined'
                      p You requested • landlord declined your request.
                    else
                      p You requested • waiting for landlord response.
      else
        .empty-state
          .empty-state__icon
            svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round')
              path(d='M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z')
          h2.empty-state__title No enquiries yet
          p.empty-state__text Once tenants start messaging about your properties, their enquiries will appear here.
          a.btn.btn--primary(href='/my-listings') View My Listings
