extends base 
block content 
  section.auth
    .auth__card
      a(href='/homepage')
        img.auth__logo(src='/img/logos/betoch-wordmark.svg' alt='Betoch logo')
      nav.auth__tabs(aria-label='Authentication')
        a.auth__tab(href='/login') Login
        a.auth__tab(href='/signup') Sign up
      h1.auth__title Forgot password?
      p.auth__subtitle
        | Enter your email and we'll send you a reset link.
      form#forgotPassword
        .form__group
          label.form__label(for='email') Email address
          input#email.form__input(type='email' placeholder='you@example.com' required='')
        button.btn.btn--primary.btn--block(type='submit')
          | Send reset link
      p.auth__footer-text
        | Remember your password?
        a(href='/login') Back to login
