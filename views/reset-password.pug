extends base 
block content 
  section.auth
    .auth__card
      a(href='/homepage')
        img.auth__logo(src='/img/logos/betoch-wordmark.svg' alt='Betoch logo')
      nav.auth__tabs(aria-label='Authentication')
        a.auth__tab(href='/login') Login
        a.auth__tab(href='/signup') Sign up
      h1.auth__title Reset your password
      p.auth__subtitle
        | Choose a new password for your account.
      form#resetPassword(data-resetToken=resetToken)
        .form__group
          label.form__label(for='password') New password
          input#password.form__input(type='password' placeholder='Min. 8 characters' required='')
        .form__group
          label.form__label(for='passwordConfirm') Confirm password
          input#passwordConfirm.form__input(type='password' placeholder='Repeat your password' required='')
        button.btn.btn--primary.btn--block(type='submit')
          | Update password
      p.auth__footer-text
        | Remember your password?
        a(href='/login') Back to login
